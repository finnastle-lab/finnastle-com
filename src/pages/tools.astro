---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedWriting from '../components/FeaturedWriting.astro';

// On-territory hub. Each tool is a specimen of "machines that make."
const tools = [
  {
    name: 'un-write',
    tag: 'Live tool',
    href: 'https://finnastle-lab.github.io/un-write/',
    repo: 'https://github.com/finnastle-lab/un-write',
    external: true,
    blurb:
      'A Hemingway-style editor that flags AI writing tells inline. Paste prose, get colour-coded highlights and a visible “how AI does this read” score. A tool that rewrites your text to sound less like AI is an AI rewriting your text.',
  },
  {
    name: 'FA Almanac',
    tag: 'Live tool',
    href: '/tools/almanac',
    internal: true,
    app: 'https://almanac.finnastle.com',
    blurb:
      'A monthly dashboard for Instagram performance: reach, engagement and the post itself, with the hashtags pulled off each caption. Every month is kept, so it reads as history and comparison instead of a single stale export.',
  },
  {
    name: 'DreadSwipe',
    tag: 'Live tool',
    href: 'https://dreadswipe.ai.studio',
    repo: 'https://github.com/finnastle-lab/Dread-Swipe',
    external: true,
    blurb:
      'Horror and thriller discovery, Tinder-style. Swipe against a custom taste taxonomy, Google Sheets holding persistent memory, Letterboxd export for the keepers.',
  },
  {
    name: 'Fact or Phishing',
    tag: 'Client tool',
    href: 'https://tekspace.com.au/tools/fact-or-phishing/',
    repo: 'https://github.com/finnastle-lab/Fact-Phish',
    external: true,
    case: '/studio#tekspace',
    blurb:
      'A Windows 95 inbox where each scenario puts a real email beside a fake one and asks which is which. Built for a Tekspace webinar; the audience asked for the link so they could run it with their own staff.',
  },
  {
    name: 'Source Material',
    tag: 'Design system',
    href: '/tools/design-system/',
    internal: true,
    blurb:
      'The brand system behind this site: the palette, three voices in tension, marks and motifs, and structural patterns.',
  },
  {
    name: 'Icon Pack',
    tag: 'Element library',
    href: '/tools/icon-pack',
    internal: true,
    blurb:
      'Scanned collage elements.',
  },
];
---
<BaseLayout title="Tools" description="Small machines that make." register="art">
  <h1>Tools</h1>
  <p>Small machines that make.</p>

  <div class="tool-list">
    {tools.map((t) => (
      <article class="tool">
        <h2>
          <a href={t.href} target={t.external ? '_blank' : undefined} rel={t.external ? 'noopener' : undefined}>{t.name}</a>
          <span class="tag">{t.tag}</span>
        </h2>
        <p>{t.blurb}</p>
        <p class="tool-links">
          <a href={t.href} target={t.external ? '_blank' : undefined} rel={t.external ? 'noopener' : undefined}>{t.app ? 'What it does →' : t.internal ? 'Open →' : 'Open the tool →'}</a>
          {t.app && <> · <a href={t.app} target="_blank" rel="noopener">Open the live tool ↗</a></>}
          {t.repo && <> · <a href={t.repo} target="_blank" rel="noopener">Source</a></>}
          {t.case && <> · <a href={t.case}>The case study →</a></>}
        </p>
      </article>
    ))}
  </div>

  <FeaturedWriting
    heading="Writing from the lab"
    slugs={[
      'things-a-certificate-wont-teach-you',
      '2020-11-23-art-meets-ai-automated-image-generation-with-a-fine-artist-touch',
    ]}
  />
</BaseLayout>
