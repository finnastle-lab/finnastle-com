---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

// Heroes live in src/assets so they get optimised; the collection stores only a
// filename, so resolve it here. Cases with no usable image simply have none,
// rather than a placeholder pretending otherwise.
const heroes = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/studio/*.{png,jpg,jpeg,webp}',
  { eager: true },
);

// Logos drop in by filename, no code change: save a genuine mark as
// src/assets/studio/logos/<key>.svg and every case listing that key picks it up.
// SVGs are inlined with every fill forced to currentColor, so they take the
// page's ink: black in light mode, white in dark, following the theme toggle.
// A transparent PNG/WebP also works, recoloured by the .mark filter.
// The closed list is wordmarks only — brand set in type, every row the same
// weight, so a case with a mark can't outrank one without. Marks appear inside
// the opened case, and the same resolver is what a client wall would use.
type Logo = ({ svg: string } | { img: ImageMetadata }) & { height: string };
const svgFiles = import.meta.glob<string>('../assets/studio/logos/*.svg', {
  eager: true, query: '?raw', import: 'default',
});
const rasterFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/studio/logos/*.{png,webp}',
  { eager: true },
);
const keyOf = (path: string) => path.split('/').pop()!.replace(/\.\w+$/, '');
const monoSvg = (raw: string) =>
  raw
    .replace(/<\?xml[^>]*>|<!--[\s\S]*?-->|<title>[\s\S]*?<\/title>/g, '')
    // Any colour becomes ink; "none" stays none.
    .replace(/\s(fill|stroke)="(?!none)[^"]*"/g, ' $1="currentColor"')
    // Root tag: drop fixed sizing (CSS sizes it), set the default fill, hide it
    // from assistive tech (the row already names the brand).
    .replace(/<svg\b[^>]*>/, (tag) =>
      tag.replace(/\s(width|height|class|style|fill|role)="[^"]*"/g, '')
        .replace('<svg', '<svg fill="currentColor" aria-hidden="true" focusable="false"'))
    .trim();
// A shared max-height makes a wide wordmark shout and a square mark whisper:
// Victoria Police is 17:1 and 7-Eleven is 3:4, so at one height the first ran
// twenty-three times the width of the second. Height comes off each mark's own
// aspect ratio instead, so the wider it is the shorter it sits, and every mark
// lands on roughly the same optical area. The exponent is below 0.5 because
// pure area-matching shrinks a long wordmark past reading size.
const aspectOf = (raw: string): number => {
  const box = raw.match(/viewBox="[\d.\-\s]*?([\d.]+)[\s,]+([\d.]+)"/);
  if (box) return Number(box[1]) / Number(box[2]);
  const w = raw.match(/\swidth="([\d.]+)/), h = raw.match(/\sheight="([\d.]+)/);
  return w && h ? Number(w[1]) / Number(h[1]) : 1;
};
const heightFor = (aspect: number): string => {
  const rem = 3.82 / Math.pow(Math.max(aspect, 0.05), 0.35);
  return `${Math.min(3.25, Math.max(1.4, rem)).toFixed(2)}rem`;
};

const logoFor = (key: string): Logo | undefined => {
  const svg = Object.entries(svgFiles).find(([p]) => keyOf(p) === key)?.[1];
  if (svg) return { svg: monoSvg(svg), height: heightFor(aspectOf(svg)) };
  const img = Object.entries(rasterFiles).find(([p]) => keyOf(p) === key)?.[1].default;
  return img && { img, height: heightFor(img.width / img.height) };
};

// Hand-ordered, strongest first. Each entry renders its own three-part body.
const entries = (await getCollection('studio', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const cases = await Promise.all(
  entries.map(async (entry) => {
    // All or nothing: a pairing (AGL × Netflix) with one mark missing would
    // read as the other brand's case, so it stays in type until both exist.
    const found = entry.data.logos.map(logoFor);
    const logos = found.length > 0 && found.every(Boolean) ? (found as Logo[]) : [];
    return {
      slug: entry.slug,
      data: entry.data,
      logos,
      hero: entry.data.hero ? heroes[`../assets/studio/${entry.data.hero}`]?.default : undefined,
      gallery: entry.data.gallery.flatMap(({ src, caption }) => {
        const img = heroes[`../assets/studio/${src}`]?.default;
        return img ? [{ img, caption }] : [];
      }),
      Content: (await entry.render()).Content,
    };
  }),
);
---
<BaseLayout title="Studio" description="Astle Creative: copywriting and campaign work for marketing teams." register="studio">
  <h1>Studio</h1>
  <p>Astle Creative. Copywriting and creative that ships at volume without losing
    the idea: full-service strategy, campaigns, tone of voice, and retail rollout.</p>

  <p>Volume without soul, or soul without volume. Most shops pick one. The current
    work is the third option: an AI-assisted pipeline built to hold quality at a
    pace it couldn't manage by hand.</p>

  <ul class="cases">
    {cases.map(({ slug, data, logos, hero, gallery, Content }) => (
      <li class="case">
        <details id={slug} name="studio-case">
          <summary class="case-row">
            <span class="case-logos">
              {/* Wordmark only. The brand is already named here, so the sub
                  below carries the discipline tag and nothing else. */}
              <span class="case-logo-type" aria-hidden="true">{data.brand}</span>
            </span>
            <span class="case-head">
              <span class="case-line">{data.line ?? data.brand}</span>
              {data.tag && <span class="case-sub">{data.tag}</span>}
            </span>
            <span class="case-toggle" aria-hidden="true"></span>
          </summary>
          <div class="case-body">
            {hero && (
              <Image class="case-hero" src={hero}
                alt={data.line ? `${data.brand}: ${data.line}` : data.brand}
                widths={[600, 1000, 1400, 1900]} sizes="(max-width: 62rem) 100vw, 59rem" />
            )}
            {data.meta && <p class="meta">{data.meta}</p>}
            <Content />
            {gallery.length > 0 && (
              <div class="case-gallery">
                {gallery.map(({ img, caption }) => (
                  <figure>
                    <Image src={img} alt={caption ? `${data.brand}: ${caption}` : data.brand}
                      widths={[600, 1000, 1400, 2000]} sizes="(max-width: 62rem) 100vw, 59rem" />
                    {caption && <figcaption>{caption}</figcaption>}
                  </figure>
                ))}
              </div>
            )}
            {logos.length > 0 && (
              <p class="case-stamp">
                {logos.map((logo) => 'svg' in logo
                  ? <span class="case-logo" style={`height:${logo.height}`} set:html={logo.svg} />
                  : <Image class="case-logo mark" src={logo.img} alt="" height={128}
                      style={`height:${logo.height}`} />)}
              </p>
            )}
            <a class="case-link" href={`#${slug}`}>Link to this case</a>
          </div>
        </details>
      </li>
    ))}
  </ul>

  <hr />
  <p>The thinking behind the work lives at <a href="/studio/fearless-answers">Fearless
    Answers</a>. Briefs and enquiries go to
    <a href="mailto:finnastle@gmail.com">finnastle@gmail.com</a>.</p>

  <!-- GO-LIVE SCOPE (2026-10-06):
       - Facts, platform lines and the verbatim copy behind every write-up come
         from the Drive research pack "Studio case assets — 2026-10" (_manifest,
         _notes), sourced against Finn's own documents. Nothing invented.
       - Logos: the SVGs in that pack's _logos/ are approximations and were not
         used. Netflix, Coca-Cola, Afterpay, Alexa and Google Assistant come from
         the Simple Icons / SVG Logos sets on npm. Finn's call, 16 Oct: the closed
         list is wordmarks only, and the marks show inside the opened case. Keeps
         every row the same weight whether or not a mark exists, and keeps the
         folder ready for a client wall.
       - Heroes missing for tekspace, google-assistant-smiling-mind,
         victoria-police-blue-space, woolworths-olive, city-of-melbourne,
         det-arc. The internal VERSA Blue
         Space flyer is deliberately not used: that case takes public images only.
       - Blue Space is written from the public Police Care Australia listing, not
         the internal flyer. Employee mental-health statistics deliberately omitted.
         bluespacewellbeing.com.au is live again as of Oct 2026, so the public
         site is now a source for both copy checks and a hero.
       - Afterpay: Finn confirmed Lead Copywriter, one of the team of three that
         created the concept and platform line. Youi stays Support Copywriter.
       - UNRESOLVED: whether the older "CJ Education" folio case is the same work
         as G8 Education.
       - CORRECTIONS from Finn, 16 Oct 2026: Share a Coke with Alexa was VERSA
         partnered with Ogilvy, not CHEP and BRX (the BRX work was Afterpay and
         Youi at Big Red). Youi's platform is you-shaped and the TVC end line is
         "Youi insurance - that's a bit more you-shaped". Blue Space was content
         strategy, not UX writing. City of Melbourne and the Victorian
         Department of Education and Training (DET, ARC learning portal) added
         as content-strategy cases, years confirmed by Finn 16 Oct (DET 2018,
         City of Melbourne 2019). DET's state confirmed the same day. It was renamed Department of Education
         in 2023, but the credit keeps the name it had at the time. -->
</BaseLayout>

<script>
  // Anchored accordion. /studio#youi opens that case on arrival; opening a case
  // puts its anchor in the address bar so the URL can be copied and shared;
  // closing it takes the anchor back off. `name` on the <details> makes them
  // exclusive (one open at a time) where supported; elsewhere they stack.
  const items = [...document.querySelectorAll<HTMLDetailsElement>('details[name="studio-case"]')];

  const openFromHash = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    const target = items.find((d) => d.id === id);
    if (!target) return;
    target.open = true;
    target.scrollIntoView({ block: 'start' });
  };

  items.forEach((d) => {
    d.addEventListener('toggle', () => {
      const url = location.pathname + location.search;
      if (d.open) {
        history.replaceState(null, '', `${url}#${d.id}`);
        // When another case closes above this one the page jumps; pull the
        // opened row back into view if its header has been pushed off-screen.
        const top = d.getBoundingClientRect().top;
        if (top < 0) d.scrollIntoView({ block: 'start' });
      } else if (location.hash === `#${d.id}`) {
        history.replaceState(null, '', url);
      }
    });
  });

  openFromHash();
  window.addEventListener('hashchange', openFromHash);
</script>

<style>
  .cases { list-style: none; margin: 2.5rem 0 0; padding: 0; border-top: 1px solid var(--line); }
  .case { border-bottom: 1px solid var(--line); }

  details { scroll-margin-top: 5rem; }      /* clear the sticky masthead */
  .case-row--soon { scroll-margin-top: 5rem; }

  .case-row {
    display: grid;
    grid-template-columns: 7.5rem 1fr auto;
    align-items: center;
    gap: 1.25rem;
    padding: 1.1rem 0;
    list-style: none;
    cursor: pointer;
  }
  .case-row::-webkit-details-marker { display: none; }
  .case-row--soon { cursor: default; }

  /* Brand slot: fixed width so the lines align down the list. Type only —
     the marks live inside the opened case. */
  .case-logos {
    display: flex; align-items: center; gap: 0.6rem;
    min-height: 2.25rem;
  }
  /* Marks in the opened case. Room here that the row doesn't have, so they run
     a little larger; a pairing sits side by side. */
  /* The stamp closes the case: the client's own mark on a ground of solid ink,
     the same way a job gets signed off. The ground is the ink colour and the
     marks are the paper colour, so the panel inverts with the theme and keeps
     the same contrast either way. Black on #121211 was invisible in dark. */
  .case-stamp {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 3rem;
    margin: 3rem 0 0;
    padding: 3.25rem 2.5rem;
    background: var(--stamp-ground, #0f0f0e);
    color: var(--stamp-mark, #ffffff);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .case-stamp {
      --stamp-ground: #eeece6;
      --stamp-mark: #0f0f0e;
      --stamp-invert: 0;
    }
  }
  :global(:root[data-theme='dark']) .case-stamp {
    --stamp-ground: #eeece6;
    --stamp-mark: #0f0f0e;
    --stamp-invert: 0;
  }
  .case-logo {
    display: block;
    /* Height is set inline, off the mark's own aspect ratio. Never `auto`:
       with width and height both auto the box measures zero before load, so a
       lazy image never enters the viewport and never loads at all. */
    width: auto;
    max-width: min(26rem, 100%);
    min-width: 0;
    flex: 0 1 auto;
    /* contain, so hitting max-width shortens the mark instead of squashing it. */
    object-fit: contain; object-position: center;
    /* Rasters carry their own ink, so flatten them to the mark colour. */
    filter: brightness(0) invert(var(--stamp-invert, 1));
  }
  /* Inline SVG marks take currentColor, which the stamp sets to the mark colour. */
  span.case-logo { color: inherit; filter: none; }
  span.case-logo :global(svg) { display: block; height: 100%; width: auto; max-width: 100%; }
  .case-logo-type {
    font-family: var(--sans);
    font-weight: 600;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.25;
    color: var(--ink);
  }

  .case-head { display: flex; flex-direction: column; gap: 0.2rem; min-width: 0; }
  .case-line {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.35rem, 3.2vw, 1.85rem);
    line-height: 1.1;
  }
  .case-sub {
    font-family: var(--sans);
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--graphite);
  }

  /* Plus that turns into a minus. Monochrome, ink only. */
  .case-toggle { position: relative; width: 14px; height: 14px; flex: none; }
  .case-toggle::before, .case-toggle::after {
    content: ""; position: absolute; left: 0; top: 50%;
    width: 100%; height: 1.5px; background: var(--ink);
    transition: transform 0.2s ease;
  }
  .case-toggle::after { transform: rotate(90deg); }
  details[open] .case-toggle::after { transform: rotate(0deg); }

  .case-soon {
    font-family: var(--sans); font-size: 0.68rem; letter-spacing: 0.06em;
    text-transform: uppercase; color: var(--graphite); white-space: nowrap;
  }
  .case-row--soon .case-line { color: var(--graphite); }

  @media (hover: hover) {
    summary.case-row:hover .case-line { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.18em; text-decoration-color: var(--accent); }
  }
  summary.case-row:focus-visible { outline: 2px solid var(--ink); outline-offset: 4px; }

  .case-body { padding: 0.25rem 0 2.25rem calc(7.5rem + 1.25rem); }
  .case-body .case-hero {
    width: 100%; height: auto; display: block;
    max-height: 34rem; object-fit: cover;
    border: 1px solid var(--line);
    margin: 0 0 1.25rem;
  }
  .case-body .meta {
    font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.05em;
    color: var(--graphite); margin: 0 0 0.5rem;
  }
  .case-body :global(h2) {
    font-family: var(--sans); font-size: 0.82rem; font-weight: 600; font-style: normal;
    text-transform: uppercase; letter-spacing: 0.08em; line-height: 1.4;
    color: var(--graphite); margin: 1.75rem 0 0.4rem;
  }
  .case-body :global(h2:first-of-type) { margin-top: 0.5rem; }
  /* Supporting shots: one per row at the hero's width. These carry detail —
     screens, packs, copy — so they get the full column rather than a thumbnail,
     and keep their own aspect ratio instead of being cropped to a band. */
  .case-gallery {
    display: grid; grid-template-columns: 1fr;
    gap: 1.25rem; margin: 1.75rem 0 0.25rem;
  }
  .case-gallery figure { margin: 0; }
  .case-gallery img {
    width: 100%; height: auto; display: block;
    border: 1px solid var(--line);
  }
  .case-gallery figcaption {
    font-family: var(--sans); font-size: 0.72rem; color: var(--graphite);
    margin-top: 0.4rem;
  }
  .case-link {
    display: inline-block; margin-top: 0.5rem;
    font-family: var(--sans); font-size: 0.75rem; color: var(--graphite);
  }

  @media (max-width: 40rem) {
    .case-row { grid-template-columns: 4.5rem 1fr auto; gap: 0.9rem; }
    .case-stamp { gap: 2rem; padding: 2.5rem 1.5rem; margin-top: 2.25rem; }
    /* Height is inline now, so clamp with max-height; the aspect ratio pulls
       the width in with it. A plain `height` here would lose to the inline. */
    .case-logo, span.case-logo { max-height: 2.2rem; max-width: 100%; }
    .case-stamp:has(.case-logo + .case-logo) .case-logo,
    .case-stamp:has(.case-logo + .case-logo) span.case-logo { max-height: 1.8rem; }
    .case-logo-type { font-size: 0.62rem; }
    .case-body { padding-left: 0; }
    .case-soon { display: none; }
  }
</style>
