---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import aglNetflix from '../assets/studio/agl-netflix.png';
import sevenEleven from '../assets/studio/seven-eleven.jpeg';
import cocaColaAlexa from '../assets/studio/coca-cola-alexa.png';
import g8Education from '../assets/studio/g8-education.png';
import afterpay from '../assets/studio/afterpay.png';
import youi from '../assets/studio/youi.png';
import grove from '../assets/studio/grove-distillery.jpg';
import welly from '../assets/studio/welly.webp';

// Case-study copy migrated from Finn's own writing. AGL/7-Eleven verified
// against 04_WORK/Career/…resume_extended-case-studies_v1; Coca-Cola/VERSA,
// G8, Afterpay, Youi verified against the live astlecreative.com folio page
// ("Pure Hard Copywriting") before its retirement — same standard, no invented
// details. AGL was one case; it's now split into the platform (Join the Change)
// and the Netflix plan launch, with the original copy divided between them.
//
// Every section is optional and renders only when present. A case with no
// write-up yet still lists (logo, line, tag) but doesn't expand. Gaps are
// tracked in 2026-10-04-studio-case-assets-brief.md.
//
// Second source pass (4 Oct 2026): Gemini's Drive extraction, with file paths
// per claim, kept in its _notes doc. Main sources: 04_WORK/Folio/"Finn Astle -
// Fearless Answerer - Experience & Case Study.pdf", 04_WORK/Career/
// 2026-08-19_LIFE_career_case-study-brief-agl-netflix-7eleven_v2,
// 2026-08-19_BIZ_astlecreative_tekspace-case-study-copy_v2, Welly Copy,
// Promotional Flyer - Bluespace, Creative Professional Timeline. Copy is quoted
// or lightly trimmed from those; years and roles follow them.
type Case = {
  slug: string;        // anchor: /studio#slug opens the case
  brand: string;       // client, as named in the row
  line: string;        // platform line or campaign name, the row's headline
  logos: string[];     // brand keys -> src/assets/studio/logos/<key>.(svg|png|webp)
  tag?: string;        // discipline, shown small; optional
  hero?: ImageMetadata;
  meta?: string;
  brief?: string; execution?: string; wrote?: string;
};

const cases: Case[] = [
  {
    slug: 'agl-join-the-change',
    brand: 'AGL',
    line: 'Join the Change',
    logos: ['agl'],
    meta:
      'AGL · Big Red Communications · Lead Creative Copywriter · 2023',
    brief:
      'The challenge was to differentiate AGL’s energy offer in a competitive, commoditised market. We needed a ‘universal truth’ that felt both ubiquitous and unique, and a strategic position for AGL’s ongoing campaign: an energetic, commercial platform that was hopeful, memorable, and clear across TV, OOH, and digital.',
    execution:
      'From gaslighting the cobbled streets of the 1900s to 2025. Given the financial climate, the ‘change’ narrative needed grounding beyond the environmental benefit, so ‘Join the Change’ became a way to frame improvement: changing how you save with the AGL app, changing how you stream Netflix with the AGL plan, or joining the drive toward electric vehicles.',
    wrote:
      'Lead copywriter for AGL across BAU, social, letter and OOH rollout: campaigns, creative strategies, templates, tone of voice. Every touchpoint changes with a rebrand, and so does the copy, from minute details to customer-facing key messages.',
  },
  {
    slug: 'agl-netflix',
    brand: 'AGL × Netflix',
    line: 'Can’t live without Netflix',
    logos: ['agl', 'netflix'],
    hero: aglNetflix,
    meta:
      'AGL × Netflix · Big Red Communications · Lead Copywriter (Broadcast & Retail) · 2023',
    brief:
      'The modern home, where Netflix is more important than heating. Streaming is as common as electricity, and every home has shows it can’t live without. A satirical campaign about life’s necessities: if you can’t live without Bridgerton, it’s included in your electricity plan.',
    execution:
      'Developed the “TV Dad” persona as the centrepiece of the platform launch, using archetypal household friction to introduce the AGL Netflix plan: energy framed as the power source for the home’s actual priorities, like streaming. Rolled out across broadcast and tactical, price-based retail assets.',
    wrote:
      'Refined the TV Dad scripts to keep the tone in observational humour; wrote the 15s and 30s broadcast spots (including the “if you can’t live without Bridgerton, it’s included in your electricity plan” hook) and managed the brand-voice rollout across retail. Total dad energy.',
  },
  {
    slug: 'afterpay',
    brand: 'Afterpay',
    line: 'However You Christmas Afterpay It',
    logos: ['afterpay'],
    hero: afterpay,
    meta:
      'Afterpay · Big Red Communications · Lead Copywriter · Christmas 2023',
    brief:
      'The insight: “Everyone Christmases differently.” People don’t just do Christmas, they execute a specific style (the Grinch, the Giver, the long luncher, the summer holidayer), and Afterpay’s partnership network is the precise transactional means for every one of them.',
    execution:
      'Built the campaign line to hold every Christmas archetype under one platform, letting the retail network do the work of proving it rather than picking a single “type” of shopper to speak to.',
    wrote:
      'One of a team of three that created the concept and the platform line, “However You Christmas Afterpay It”. Wrote the archetype copy: the Grinch, the Giver, the long luncher, the summer holidayer. Plus the innovation activations: “Merry Re-giftmas” and “Drop a hint & win”.',
  },
  {
    slug: 'youi',
    brand: 'Youi',
    line: 'A bit more you-shaped',
    logos: ['youi'],
    hero: youi,
    meta:
      'Youi · Big Red Communications · Copywriter & Creative Ideator · 2023',
    brief:
      'Extend the You-Shaped Insurance platform beyond the policy and across the brand ecosystem: the promise that cover should fit the person, not the other way round.',
    execution:
      'Took the idea from the tangible (You-shaped car air fresheners) to the massive scale: a sponsored You-shaped goal post at the NRL. An integrated campaign anchored on one throughline.',
    wrote:
      'Wrote the ecosystem extensions and the anchoring promise: capturing the moments when your insurance “truly fits ‘you.’” “Car insurance that’s you-shaped? That’s a breath of fresh air.”',
  },
  {
    slug: 'seven-eleven',
    brand: '7-Eleven',
    line: 'Summer 24/7',
    logos: ['7-eleven'],
    hero: sevenEleven,
    meta:
      '7-Eleven · CHEP Network · Copywriter · 2021–22',
    brief:
      'For 7-Eleven’s 25th anniversary in Australia, bring the “Wonderfully Easier” platform into social and prove the brand’s 24/7 convenience: a looping day-into-night hook that mirrored summer energy, day into night and back again. The answer: 7-Eleven’s open 24/7, so you can summer 24/7.',
    execution:
      'Produced high-volume social iterations and iPhone-style shorts. To stretch the budget, we architected a day/night shooting technique: talent filmed in both time-of-day settings so the edit could switch seamlessly, giving a genuine 24/7 feel without the cost of multiple shoots.',
    wrote:
      'Led the social-first copy for short vertical formats; wrote the day-into-night transition scripts and optimised the looping hook for IG Stories and in-feed, punchy and tuned to morning-coffee-to-late-night-snack habits.',
  },
  {
    slug: 'welly',
    brand: 'Welly',
    line: '5 a day the easy way',
    logos: ['welly'],
    hero: welly,
    meta:
      'Welly · Freelance · Creative Director & Lead Copywriter · 2022',
    brief:
      'A sustainability-led smoothie brand needed copy that made “5 a day” feel achievable rather than virtuous, for both a kids’ range and an adult range, built on freeze-dried, upcycled produce that would otherwise go to landfill.',
    execution:
      'Anchored the brand voice in the actual insight (96% of children and 90% of adults miss their recommended fruit and veg intake) and turned the sustainability angle into brand substance rather than a footnote: transparent sourcing, upcycled produce, a 2025 zero-waste target.',
    wrote:
      'Wrote the core platform lines (“5 a day the easy way! Just Rip, Tip, Shake, Sip!” “100% transparent goodness,” “From the earth, for you”) across web copy, product range messaging, and the kids/adults range split.',
  },
  {
    slug: 'inke',
    brand: 'Inke',
    line: 'Send Joy',
    logos: ['inke'],
    meta:
      'Inke · Freelance · Creative Director & Brand Strategist',
    brief:
      'A brand platform paired with inke’s sustainably designed custom packaging for brands. Like the cultural saying: if something doesn’t spark joy, it’s probably not worth spending time on.',
    execution:
      'Working with the business owner to tell the brand story across social media, their website, and product packaging. It was a joy working with inke!',
    wrote:
      'The brand line, across brochure, sleeve and shopfront: “We are inke. A custom packaging partner. We deliver scaleable, sustainable packages. We help you Send Joy.”',
  },
  {
    slug: 'grove-distillery',
    brand: 'The Grove Distillery',
    line: 'The Spirit Of',
    logos: ['grove-distillery'],
    tag: 'Copywriting',
    hero: grove,
    meta:
      'The Grove Distillery · Freelance · Tone of Voice, Messaging & Web Copy',
    brief:
      'The first craft spirit distillery in the Margaret River region needed a brand platform to carry it from family hobby to a serious East Coast expansion: tone of voice, messaging architecture, and web copy built around one throughline, the story in every bottle.',
    execution:
      'Built the platform on the brand’s own history (a still bought in 2010, the first sent to Western Australia) and translated it into a tone that could flex across the distillery, the accommodation, and the product range without losing the thread.',
    wrote:
      'Wrote the platform line “Distilled with a story. Delivered to you.” and the supporting territory: “Made on this land. Distilled in history.” Developed the positioning statement, “Pioneers of the craft,” used across web and social. And the Spiced Rum campaign headline: “Unlike Any Other.”',
  },
  {
    slug: 'coca-cola-alexa',
    brand: 'Coca-Cola × Amazon Alexa',
    line: 'Share a Coke with Alexa',
    logos: ['coca-cola', 'amazon-alexa'],
    tag: 'Copywriting',
    hero: cocaColaAlexa,
    meta:
      'Coca-Cola South Pacific × Amazon · VERSA · Copywriter & Voice Flow Designer · 2019',
    brief:
      'A limited voice-commerce promotion built between Ogilvy, Coca-Cola Australia, and Amazon: ask Alexa to “Share a Coke” and get a free personalised can. Conversational design for one of the first voice-led FMCG promotions in the region.',
    execution:
      'Designed the Alexa conversation flow to sit on top of Ogilvy’s creative platform, keeping the exchange elegant enough to feel like a gift, not a form. Layered in sonic branding to give the interaction its own “fizz.”',
    wrote:
      'Wrote the chat-flow dialogue (prompts, confirmations, the personalisation moment) and the sonic-branding brief that shaped how the promotion sounded, not just read. The call to action: say “Alexa, let’s share a Coke” to get a free personalised bottle.',
  },
  {
    slug: 'tekspace',
    brand: 'Tekspace',
    line: 'Research',
    logos: ['tekspace'],
    tag: 'Content Strategy',
    meta:
      'Tekspace · In-house · Marketing Specialist · 2025–now',
    brief:
      'Tekspace sells trust in a market built on scepticism. Cyber security buyers are burned out on vendor marketing: every product claims to be the best, and IT leaders have no independent way to check. Tekspace’s team had the operator-level expertise to say something real, but it had never been made public.',
    execution:
      'Designed and ran the Tekspace Cyber Lab, an in-house research program that benchmarks every major vendor in a category against a proprietary scoring framework (the Tekspace Cyber Continuum™), grading real capabilities rather than marketing claims. Three reports across two sprints: Email Security (18 vendors), Browser Security (13 vendors, 400+ raw features normalised into 40 comparable capabilities) and Security Awareness Training (20 vendors).',
    wrote:
      'Built an agentic AI production pipeline that doubled research output sprint-over-sprint, with no added budget or headcount. Cited in Google’s AI Overview as a primary source for browser-security vendor queries, and picked up by TechDay Australia, SecurityBrief Australia, ChannelLife AU and IT Brief.',
  },
  {
    slug: 'google-assistant-smiling-mind',
    brand: 'Google Assistant × Smiling Mind',
    line: 'Google Assistant × Smiling Mind',
    logos: ['google-assistant', 'smiling-mind'],
    tag: 'UX Writing',
    meta:
      'Smiling Mind × Google Assistant · VERSA / Deepend · Conversational UX Writer · 2018–20',
    brief:
      'Translate the Smiling Mind app’s UX into conversational voice flows for Google Assistant.',
    execution:
      'Scripted and built the voice experience, modelling the dialogue and user flows in Dialogflow for Google Assistant.',
    wrote:
      'Written to one principle: greetings matter. They’re our first point of contact with a world that hasn’t met us yet. When someone you don’t know says Hello, the way you say Hey back reveals a lot about you.',
  },
  {
    slug: 'victoria-police-blue-space',
    brand: 'Victoria Police',
    line: 'Blue Space',
    logos: ['victoria-police'],
    meta:
      'Victoria Police · VERSA · UX Writer & Content Strategist · 2019',
    brief:
      'A wellbeing platform for current and former Victoria Police employees and their immediate families. People who protect the public need to protect themselves too.',
    execution:
      'Made for police by police: built in collaboration with over 4,000 people across the Victoria Police community. Crisis support, help for you (alcohol, exercise, nutrition, sleep, mindfulness), help for loved ones, and lived-experience stories. Completely confidential.',
    wrote:
      'The welcome for new recruits: “As a police officer, your duty is to protect the public. But, as important as public safety is, your first duty is your own mental health and wellbeing.”',
  },
  {
    slug: 'woolworths-olive',
    brand: 'Woolworths',
    line: 'Olive, the Woolworths chatbot',
    logos: ['woolworths'],
    meta:
      'Woolworths (WooliesX) · VERSA · Conversational Copywriter · 2018',
    brief:
      'Olive, the customer-facing chatbot for WooliesX. My first chatbot project.',
    execution:
      'Edited longform FAQs into chatbot content, taking the project from design through to content with the lead conversation designer.',
    wrote:
      '“Early on in my writing career, I got to assist with the conversational design and writing for Olive.”',
  },
  {
    slug: 'g8-education',
    brand: 'G8 Education',
    line: 'Love them with us',
    logos: ['g8-education'],
    hero: g8Education,
    meta:
      'G8 Education · CHEP Network · Copywriter · 2021–22',
    brief:
      '“If drop-off guilt is real, how do you help parents feel okay?” A platform and campaign for re-engaging post-COVID early-education enrolment, built on the emotional arc of growing up: from the difficulty of the drop-off to the quiet pride of graduation.',
    execution:
      'A Film-Diary structure merging fragments from diverse families to find common ground in the drop-off drama: the shift from tears to unforced smiles. The strategy isolated the sublime in the mundane: a handhold on the bus, a fleeting smile in the back seat.',
    wrote:
      'Wrote the platform line, “You aren’t leaving them; you are loving them with us,” and the copy framework built around those small, currency-of-affirmation moments.',
  },
];

// Logos drop in by filename, no code change: save a transparent SVG/PNG as
// src/assets/studio/logos/<key>.svg and every case naming that key picks it up.
// They render as flat ink (black on light, white on dark) via the .mark filter,
// so they need a transparent background. Until a file exists, the brand name
// stands in as type.
const logoFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/studio/logos/*.{svg,png,webp}', { eager: true },
);
const logoFor = (key: string) =>
  Object.entries(logoFiles).find(([path]) => path.split('/').pop()!.replace(/\.\w+$/, '') === key)?.[1].default;

const hasBody = (c: Case) => !!(c.hero || c.brief || c.execution || c.wrote);
const sections = (c: Case) => ([
  ['The brief', c.brief], ['The execution', c.execution], ['What I wrote', c.wrote],
] as const).filter(([, text]) => text);
---
<BaseLayout title="Studio" description="Astle Creative: copywriting and campaign work for marketing teams." register="studio">
  <h1>Studio</h1>
  <p>Astle Creative. Copywriting and creative that ships at volume without losing
    the idea: full-service strategy, campaigns, tone of voice, and retail rollout.</p>

  <p>Volume without soul, or soul without volume. Most shops pick one. The current
    work is the third option: an AI-assisted pipeline built to hold quality at a
    pace it couldn't manage by hand.</p>

  <ul class="cases">
    {cases.map((c) => {
      const hasLogo = c.logos.some((key) => logoFor(key));
      const head = (
        <>
          <span class="case-logos">
            {c.logos.map((key) => {
              const logo = logoFor(key);
              return logo
                ? <Image class="case-logo mark" src={logo} alt="" height={64} />
                : null;
            })}
            {!hasLogo && (
              <span class="case-logo-type" aria-hidden="true">{c.brand}</span>
            )}
          </span>
          <span class="case-head">
            <span class="case-line">{c.line}</span>
            <span class="case-sub">
              {/* With no logo yet the brand is already set as type on the left. */}
              {hasLogo && <span class="case-brand">{c.brand}</span>}
              {c.tag && <span class="case-tag" data-sep={hasLogo ? '' : undefined}>{c.tag}</span>}
            </span>
          </span>
        </>
      );
      return (
        <li class="case">
          {hasBody(c) ? (
            <details id={c.slug} name="studio-case">
              <summary class="case-row">
                {head}
                <span class="case-toggle" aria-hidden="true"></span>
              </summary>
              <div class="case-body">
                {c.hero && (
                  <Image class="case-hero" src={c.hero} alt={`${c.brand}: ${c.line}`}
                    widths={[600, 1000, 1400]} sizes="(max-width: 62rem) 100vw, 59rem" />
                )}
                {c.meta && <p class="meta">{c.meta}</p>}
                {sections(c).map(([label, text]) => (
                  <>
                    <h3>{label}</h3>
                    <p>{text}</p>
                  </>
                ))}
                <a class="case-link" href={`#${c.slug}`}>Link to this case</a>
              </div>
            </details>
          ) : (
            <div id={c.slug} class="case-row case-row--soon">
              {head}
              <span class="case-soon">Write-up soon</span>
            </div>
          )}
        </li>
      );
    })}
  </ul>

  <hr />
  <p>The thinking behind the work lives at <a href="/studio/fearless-answers">Fearless
    Answers</a>. Briefs and enquiries go to
    <a href="mailto:finnastle@gmail.com">finnastle@gmail.com</a>.</p>

  <!-- GO-LIVE SCOPE:
       - Hero images sourced from Drive (04_WORK/Folio) 30 Aug 2026: Coca-Cola/Alexa,
         Afterpay, Youi. Grove hero is the Caribbean Spiced product shot from the
         2021 rum campaign archive (99_ARCHIVE/The Grove Rum Campaign.zip).
       - Years/agency unstated in source for G8 and Afterpay — left out rather
         than invented; confirm if they should be added.
       - Coca-Cola case is voice/chat-flow work, not a traditional ad — confirmed
         framing before go-live.
       - Logos, missing heroes and the write-ups for the newer cases: see
         2026-10-04-studio-case-assets-brief.md.
       - TODO(strategy): the forward AI-content-ops offer per five-year-plan. -->
</BaseLayout>

<script>
  // Anchored accordion. /studio#youi opens that case on arrival; opening a case
  // puts its anchor in the address bar so the URL can be copied and shared;
  // closing it takes the anchor back off. `name` on the <details> makes them
  // exclusive (one open at a time) where supported; elsewhere they stack.
  const items = [...document.querySelectorAll<HTMLDetailsElement>('details[name="studio-case"]')];

  const openFromHash = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    const target = items.find((d) => d.id === id);
    if (!target) return;
    target.open = true;
    target.scrollIntoView({ block: 'start' });
  };

  items.forEach((d) => {
    d.addEventListener('toggle', () => {
      const url = location.pathname + location.search;
      if (d.open) {
        history.replaceState(null, '', `${url}#${d.id}`);
        // When another case closes above this one the page jumps; pull the
        // opened row back into view if its header has been pushed off-screen.
        const top = d.getBoundingClientRect().top;
        if (top < 0) d.scrollIntoView({ block: 'start' });
      } else if (location.hash === `#${d.id}`) {
        history.replaceState(null, '', url);
      }
    });
  });

  openFromHash();
  window.addEventListener('hashchange', openFromHash);
</script>

<style>
  .cases { list-style: none; margin: 2.5rem 0 0; padding: 0; border-top: 1px solid var(--line); }
  .case { border-bottom: 1px solid var(--line); }

  details { scroll-margin-top: 5rem; }      /* clear the sticky masthead */
  .case-row--soon { scroll-margin-top: 5rem; }

  .case-row {
    display: grid;
    grid-template-columns: 7.5rem 1fr auto;
    align-items: center;
    gap: 1.25rem;
    padding: 1.1rem 0;
    list-style: none;
    cursor: pointer;
  }
  .case-row::-webkit-details-marker { display: none; }
  .case-row--soon { cursor: default; }

  /* Logo slot: fixed width so the lines align down the list. */
  .case-logos {
    display: flex; align-items: center; gap: 0.6rem;
    min-height: 2.25rem;
  }
  .case-logo {
    display: block;
    height: auto; width: auto;
    max-height: 1.9rem;
    max-width: 100%;
    min-width: 0;
    flex: 0 1 auto;
  }
  .case-logos:has(.case-logo + .case-logo) .case-logo { max-height: 1.5rem; max-width: 46%; }
  .case-logo-type {
    font-family: var(--sans);
    font-weight: 600;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.25;
    color: var(--ink);
  }

  .case-head { display: flex; flex-direction: column; gap: 0.2rem; min-width: 0; }
  .case-line {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.35rem, 3.2vw, 1.85rem);
    line-height: 1.1;
  }
  .case-sub {
    font-family: var(--sans);
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--graphite);
  }
  .case-tag { white-space: nowrap; }
  .case-tag[data-sep]::before { content: "·"; margin: 0 0.45rem; }

  /* Plus that turns into a minus. Monochrome, ink only. */
  .case-toggle { position: relative; width: 14px; height: 14px; flex: none; }
  .case-toggle::before, .case-toggle::after {
    content: ""; position: absolute; left: 0; top: 50%;
    width: 100%; height: 1.5px; background: var(--ink);
    transition: transform 0.2s ease;
  }
  .case-toggle::after { transform: rotate(90deg); }
  details[open] .case-toggle::after { transform: rotate(0deg); }

  .case-soon {
    font-family: var(--sans); font-size: 0.68rem; letter-spacing: 0.06em;
    text-transform: uppercase; color: var(--graphite); white-space: nowrap;
  }
  .case-row--soon .case-line { color: var(--graphite); }

  @media (hover: hover) {
    summary.case-row:hover .case-line { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.18em; text-decoration-color: var(--accent); }
  }
  summary.case-row:focus-visible { outline: 2px solid var(--ink); outline-offset: 4px; }

  .case-body { padding: 0.25rem 0 2.25rem calc(7.5rem + 1.25rem); }
  .case-body .case-hero {
    width: 100%; height: auto; display: block;
    max-height: 34rem; object-fit: cover;
    border: 1px solid var(--line);
    margin: 0 0 1.25rem;
  }
  .case-body .meta {
    font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.05em;
    color: var(--graphite); margin: 0 0 0.5rem;
  }
  .case-body h3 { margin-top: 1.5rem; }
  .case-link {
    display: inline-block; margin-top: 0.5rem;
    font-family: var(--sans); font-size: 0.75rem; color: var(--graphite);
  }

  @media (max-width: 40rem) {
    .case-row { grid-template-columns: 4.5rem 1fr auto; gap: 0.9rem; }
    .case-logo { max-height: 1.5rem; }
    .case-logos:has(.case-logo + .case-logo) { flex-direction: column; align-items: flex-start; gap: 0.35rem; }
    .case-logos:has(.case-logo + .case-logo) .case-logo { max-width: 100%; max-height: 1.1rem; }
    .case-logo-type { font-size: 0.62rem; }
    .case-body { padding-left: 0; }
    .case-soon { display: none; }
  }
</style>
