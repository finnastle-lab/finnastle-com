---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { chapterSlugs, getChapterDetail } from '../../lib/work-chapters';

export async function getStaticPaths() {
  return chapterSlugs().map((slug) => ({ params: { chapter: slug } }));
}

const { chapter } = Astro.params;
const c = await getChapterDetail(chapter!);
if (!c) throw new Error(`Unknown chapter: ${chapter}`);

// Intrinsic dimensions for the key image, and for every image the thumbs can
// swap in. Without them the page reflows on load, and again on each swap
// whenever the next image is a different shape. These come off the source
// artwork, so they stay right no matter which srcset candidate the browser
// picks.
const dims = c.dims;
---
<BaseLayout title={c.title} description={`${c.title}: collage, painting, mixed media.`} register="art">
  <p><a href="/work">← Work</a></p>
  <h1>{c.title}</h1>
  {c.blurb && <p>{c.blurb}</p>}

  <article class="chapter" data-chapter>
    {/* aspect-ratio, not just width/height: once an image has loaded, its
        natural size overrides the attributes, so an attribute-only swap
        reflows late. A CSS ratio keeps the box authoritative throughout. */}
    <img class="chapter-key" data-main src={c.large[0].src} alt={c.title}
      srcset={c.large[0].srcSet.attribute} sizes={c.large[0].attributes.sizes}
      width={dims[0].w} height={dims[0].h}
      style={`aspect-ratio: ${dims[0].w} / ${dims[0].h}`} />
    {c.count > 1 && (
      <div class="chapter-thumbs" role="group" aria-label={`${c.title} images`}>
        {c.large.map((lg, i) => (
          <button type="button" class="thumb" data-full={lg.src}
            data-srcset={lg.srcSet.attribute} data-sizes={lg.attributes.sizes}
            data-w={dims[i].w} data-h={dims[i].h}
            data-alt={`${c.title} ${i + 1}`}
            aria-current={i === 0 ? 'true' : undefined}>
            {/* The generated thumb is 320 wide but keeps the artwork's shape,
                so its real height varies. Claiming 320x320 here described a
                square that never existed, and reflowed the strip on load. */}
            <img src={c.thumb[i].src} alt={`${c.title} ${i + 1}`} loading="lazy"
              width={c.thumb[i].attributes.width} height={c.thumb[i].attributes.height} />
          </button>
        ))}
      </div>
    )}
  </article>

  <!-- TODO(content): year/medium/dimensions; a short note per chapter. -->
</BaseLayout>

<script>
  document.querySelectorAll('[data-chapter]').forEach((ch) => {
    const main = ch.querySelector('[data-main]') as HTMLImageElement | null;
    const thumbs = ch.querySelectorAll<HTMLButtonElement>('.thumb');
    thumbs.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (main && btn.dataset.full) {
          // Resize the box in the same tick as the click. The user caused it,
          // so it reads as a response; left to the image's load event it would
          // land hundreds of ms later as an unexplained jump.
          if (btn.dataset.w && btn.dataset.h) {
            main.style.aspectRatio = `${btn.dataset.w} / ${btn.dataset.h}`;
          }
          // srcset outranks src, so a src-only swap would keep showing the
          // previous image. Set both, srcset first.
          if (btn.dataset.srcset) main.srcset = btn.dataset.srcset;
          if (btn.dataset.sizes) main.sizes = btn.dataset.sizes;
          main.src = btn.dataset.full;
          if (btn.dataset.alt) main.alt = btn.dataset.alt;
        }
        thumbs.forEach((b) => b.removeAttribute('aria-current'));
        btn.setAttribute('aria-current', 'true');
      });
    });
  });
</script>
