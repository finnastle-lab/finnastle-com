---
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import cloud from '../../assets/elements/comic-cloud-hatched-outline.png';
const cloudImg = await getImage({ src: cloud, width: 192, format: 'webp' });

// Content salvaged from astlecreative.com before retirement — the
// philosophy/bio page (/fearlessanswer) combined with the homepage's
// positioning, skills, and client list. See _migration/astlecreative-content.md
// for the verified source. This is the redirect-map.md target for
// astlecreative.com/fearlessanswer.
// Pairs, not two parallel lists: the tension is the point, so each word
// sits opposite the one it argues with.
const pairs = [
  ['Not knowing', 'Certainty'],
  ['Possibilities', 'End-states'],
  ['Freedom', 'Structure'],
  ['Rawness', 'Strategy'],
];

const prongs = [
  { name: 'Creativity', body: 'The idea that wasn’t there before.' },
  { name: 'Content', body: 'What it becomes. Any format, any channel.' },
  { name: 'Strategy', body: 'The planning and technical rigour that takes it to market at volume.' },
];

const skills = [
  { name: 'Copywriting', prong: 'Creativity', body: 'Grew up with a writer dad, a publisher mum: the craft is the constant across every register, from a broadcast script to a product line.' },
  { name: 'Platforms & Campaigns', prong: 'Creativity', body: 'Global campaigns for major brands, built from a single idea that can flex across every channel.' },
  { name: 'Content Design', prong: 'Content', body: 'Government websites, chatbots, apps: content that has to work, not just read well.' },
  { name: 'Social', prong: 'Content', body: 'A meta native, trained in Snapchat, TikTok, and a follower of pop culture and cultural trends. Finds the right words for ads and creates ideas that feel native to their home.' },
  { name: 'Strategy', prong: 'Strategy', body: 'Schooled by Creative & Strategy Directors alongside agency owners. Balancing creative thinking in strategic reasoning to express ideas that feel just as fun or fearless as they are effective.' },
  { name: 'Branding', prong: 'Strategy', body: 'Helping brands find their voice through design and writing: tone of voice, messaging architecture, brand platforms.' },
];

const clients = [
  'AGL', 'Youi', 'Afterpay', 'Big Red', 'BRX', 'CHEP Network', '7-Eleven',
  'Stegbar', 'G8 Education', 'Telstra', 'Flybuys', 'VERSA', 'Nova', 'Ford',
  'Dialogflow', 'Coca-Cola', 'Deepend', 'Fuel Agency',
];
---
<BaseLayout title="Fearless Answers" description="Not knowing, and pushing ahead with purpose anyway. Proving the value of a creative thinker." register="studio">
  <p><a href="/studio">← Studio</a></p>

  <section class="fa-duality">
    <h1 class="fa-head">Fearless <span class="amp">&amp;</span> Answers</h1>
    <p class="fa-def">Not knowing, and pushing ahead with purpose anyway.</p>
    <img class="stamp" src={cloudImg.src} alt="" aria-hidden="true"
      style="top:-1rem; right:-1rem; width:96px; opacity:.6;" />
  </section>

  <p>Marketing changes fast enough that uncertainty is the only certainty. So I
    leaned into it.</p>

  <ul class="fa-pairs">
    {pairs.map(([a, b]) => (
      <li><span>{a}</span><i class="fa-vs">&amp;</i><span>{b}</span></li>
    ))}
  </ul>

  <p class="fa-lede">The modern creative is difficult to capture in a sentence
    because they are <strong>not one single thing</strong>.</p>

  <p>Freedom needs a frame. Expression needs strategy. Leave ego and assumption
    at the door. Focus on what you can change. Meet infinite possibilities with
    true direction.</p>

  <h2>How the work gets delivered</h2>
  <div class="fa-prongs">
    {prongs.map((p) => (
      <div class="fa-prong">
        <h3>{p.name}</h3>
        <p>{p.body}</p>
      </div>
    ))}
  </div>

  <h3>Background</h3>
  <p>Published projects, written for national campaigns, and led teams
    implementing content strategies at Melbourne’s top creative shops:
    CHEP Network, Big Red, Deepend & VERSA, Fuel Agency.</p>

  <h3>Credentials</h3>
  <ul>
    <li>Bachelor’s Degree in Communication, RMIT</li>
    <li>Tertiary Arts Grant recipient (2018)</li>
    <li>B&amp;T’s 30 Under 30 Creative Award honoree</li>
    <li>D&amp;AD Young Bloods and Snapchat Lions finalist</li>
  </ul>

  <h2>Skills and counting</h2>
  {prongs.map((p) => (
    <div class="fa-group">
      <p class="fa-group-label">{p.name}</p>
      <div class="fa-skills">
        {skills.filter((s) => s.prong === p.name).map((s) => (
          <details>
            <summary>{s.name}</summary>
            <p>{s.body}</p>
          </details>
        ))}
      </div>
    </div>
  ))}

  <h2>Working for clients with purpose</h2>
  <p>Communications for all kinds of business: copywriting and creative
    direction or content strategy, for E-Commerce, Health, Lifestyle, and B2B.</p>
  <ul class="fa-clients">
    {clients.map((c) => <li>{c}</li>)}
  </ul>

  <hr />
  <p class="stub">For a freelance writer/designer/wizard. Enquiries via
    <a href="mailto:finnastle@gmail.com">finnastle@gmail.com</a>.</p>

  <!-- TODO(content): "Not commencing any freelance work until Q2 2026" was on
       the old site — confirm current availability before this goes live.
       TODO(design): source real client wordmarks/logos for a proper monochrome
       wall (currently a plain text list); gif-led project heroes per the
       reference deep-dive are a further design pass. -->
</BaseLayout>

<style>
  .fa-duality {
    position: relative;
    margin: 1.5rem 0 2rem;
  }
  .fa-head {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(2.2rem, 8vw, 4rem);
    margin: 0 0 0.75rem;
  }
  .fa-head .amp { color: var(--accent); font-style: normal; }
  .fa-def {
    font-family: var(--sans);
    font-size: 1.05rem;
    color: var(--graphite);
    margin: 0;
    max-width: 28rem;
  }
  .fa-pairs {
    list-style: none;
    margin: 2rem 0;
    padding: 0;
    border-top: 1px solid var(--line);
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.15rem;
  }
  .fa-pairs li {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: baseline;
    gap: 0.9rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--line);
  }
  .fa-pairs li > span:last-child { text-align: right; }
  .fa-vs { color: var(--accent); font-style: normal; font-size: 0.9em; }
  .fa-prongs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 1.5rem;
    margin: 1.5rem 0 2.5rem;
    border-top: 1px solid var(--line);
    padding-top: 1.5rem;
  }
  .fa-prong h3 {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.3rem;
    margin: 0 0 0.4rem;
  }
  .fa-prong p { margin: 0; color: var(--graphite); }
  .fa-group { margin-top: 1.75rem; }
  .fa-group-label {
    font-family: var(--sans);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--graphite);
    margin: 0;
  }
  .fa-lede { font-family: var(--serif); font-style: italic; font-size: 1.3rem; max-width: 30rem; }
  .fa-lede strong { text-decoration: underline; text-decoration-color: var(--accent); }
  .fa-skills { border-top: 1px solid var(--line); margin-top: 1.5rem; }
  .fa-skills details { border-bottom: 1px solid var(--line); padding: 0.9rem 0; }
  .fa-skills summary {
    font-family: var(--serif); font-style: italic; font-size: 1.2rem;
    cursor: pointer; list-style: none;
  }
  .fa-skills summary::-webkit-details-marker { display: none; }
  .fa-skills p { margin: 0.75rem 0 0; color: var(--graphite); }
  .fa-clients {
    list-style: none; margin: 1.5rem 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: 0.6rem 1rem;
    font-family: var(--sans); font-size: 0.82rem; color: var(--graphite);
  }
  .fa-clients li { border: 1px solid var(--line); padding: 0.25rem 0.7rem; border-radius: 999px; }
</style>
