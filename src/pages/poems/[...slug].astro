---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const poems = await getCollection('poems', ({ data }) => !data.draft || import.meta.env.DEV);
  const ordered = poems.sort((a, b) => a.data.order - b.data.order);
  return ordered.map((entry, i) => ({
    params: { slug: entry.slug },
    // Sequence neighbours, so a reader can walk the cycle in order.
    props: { entry, prev: ordered[i - 1] ?? null, next: ordered[i + 1] ?? null },
  }));
}

type Props = {
  entry: CollectionEntry<'poems'>;
  prev: CollectionEntry<'poems'> | null;
  next: CollectionEntry<'poems'> | null;
};
const { entry, prev, next } = Astro.props;
const { Content } = await entry.render();
---
<BaseLayout title={entry.data.title} description={entry.data.cycle} register="art">
  <article class="poem">
    <h1>{entry.data.title}</h1>

    {(entry.data.cycle || entry.data.provenance) && (
      <p class="poem-meta">
        {entry.data.cycle}
        {entry.data.cycle && entry.data.provenance && ' · '}
        {entry.data.provenance}
      </p>
    )}

    {/* pre-wrap lives on this wrapper so the newlines written in the markdown
        survive to the page. Every poem's breaks are authored. */}
    <div class="poem-body">
      <Content />
    </div>

    <nav class="poem-nav" aria-label="Sequence">
      {prev ? (
        <a href={`/poems/${prev.slug}`} rel="prev">
          <span aria-hidden="true">←</span> {prev.data.title}
        </a>
      ) : <span></span>}
      {next ? (
        <a href={`/poems/${next.slug}`} rel="next">
          {next.data.title} <span aria-hidden="true">→</span>
        </a>
      ) : <span></span>}
    </nav>

    <p class="poem-back"><a href="/poems">All poems</a></p>
  </article>
</BaseLayout>
