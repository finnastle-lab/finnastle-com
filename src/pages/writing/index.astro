---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-AU', { year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout title="Writing" description="Essays: the canonical home. Medium and LinkedIn are syndication only." register="art">
  <h1>Writing</h1>
  <p>Canonical home for the essays. Medium and LinkedIn carry syndicated copies
    that point back here.</p>

  {essays.length === 0 ? (
    <p class="stub">No published essays yet. The placeholder is a draft and is
      hidden. First real essay ships from the cascade.</p>
  ) : (
    <ul class="essay-list">
      {essays.map((e) => (
        <li class="essay-item">
          {e.data.heroImage && (
            <a href={`/writing/${e.slug}/`} class="essay-thumb">
              <Image src={e.data.heroImage} alt={e.data.heroImageAlt ?? ''} widths={[160, 320]} sizes="120px" />
            </a>
          )}
          <span>
            <a href={`/writing/${e.slug}/`}>{e.data.title}</a>
            {' · '}
            <time datetime={e.data.pubDate.toISOString()}>{fmt(e.data.pubDate)}</time>
          </span>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
