---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { SOCIAL } from '../../consts';

export async function getStaticPaths() {
  const essays = await getCollection('essays', ({ data }) => !data.draft);
  return essays.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

type Props = { entry: CollectionEntry<'essays'> };
const { entry } = Astro.props;
const { Content } = await entry.render();
const fmt = (d: Date) =>
  d.toLocaleDateString('en-AU', { year: 'numeric', month: 'long', day: 'numeric' });

const PLATFORM: Record<string, string> = { medium: 'Medium', linkedin: 'LinkedIn' };
const platform = entry.data.syndicatedFrom ? PLATFORM[entry.data.syndicatedFrom] : null;

// Per-essay closing line, with a house fallback for anything that hasn't got one.
const cta =
  entry.data.instagramCta ??
  'If this was your kind of thinking, there’s more of it on Instagram. Plus the drawings, which are the actual job.';
---
<BaseLayout title={entry.data.title} description={entry.data.description} register="art">
  <article class="essay">
    <h1>{entry.data.title}</h1>

    {entry.data.description && <p class="essay-standfirst">{entry.data.description}</p>}

    <p class="essay-meta">
      <time datetime={entry.data.pubDate.toISOString()}>{fmt(entry.data.pubDate)}</time>
      {platform && entry.data.canonicalUrl && (
        <>
          {' · '}First published on <a href={entry.data.canonicalUrl} rel="external">{platform}</a>,
          kept here as written
        </>
      )}
    </p>

    <p class="essay-follow-top">
      When I’m not writing I’m making things. Those go to
      {' '}<a href={SOCIAL.instagram} rel="me">Instagram</a>. Same territory, fewer words.
    </p>

    {entry.data.heroImage && (
      <Image
        class="essay-hero"
        src={entry.data.heroImage}
        alt={entry.data.heroImageAlt ?? ''}
        widths={[480, 960]}
        sizes="(min-width: 700px) 700px, 100vw"
        /* Small hand-drawn marks stay at native size rather than upscaling into mush. */
        style={`max-width: min(100%, ${entry.data.heroImage.width}px)`}
      />
    )}

    <Content />

    <aside class="essay-follow">
      <p class="essay-follow-copy">{cta}</p>
      <a class="essay-follow-btn" href={SOCIAL.instagram} rel="me">
        Follow {SOCIAL.instagramHandle} <span aria-hidden="true">→</span>
      </a>
    </aside>
  </article>
</BaseLayout>
