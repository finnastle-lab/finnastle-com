---
import BaseLayout from '../layouts/BaseLayout.astro';
import SkyPanel from '../components/home/SkyPanel.astro';
import MarginCutouts from '../components/home/MarginCutouts.astro';
import FooterWordmark from '../components/home/FooterWordmark.astro';
import { MARGIN_GROUPS } from '../lib/home-atmosphere';
import '../styles/home.css';

// Studio and Lab are the two on-page destinations. Art and Writing keep theirs
// in the footer hero, where they read larger than a card would give them.
const destinations = [
  { href: '/studio', label: 'Studio', body: 'Campaigns, copy and content design. The briefs, the work and what I did.' },
  { href: '/tools', label: 'Lab', body: 'Experiments, tools and work in progress.' },
];

const margins = (section: 'hero' | 'proof') =>
  MARGIN_GROUPS.filter((group) => group.section === section);
---
<BaseLayout title="Finn Astle" register="art" wide>
  <section class="home-section home-hero">
    <div class="home-col">
      <p class="home-eyebrow">Finn Astle · Astle Creative</p>
      <h1 class="home-title">Fearless <span class="amp">&amp;</span> Answers</h1>
      <p class="home-lead">Creative thinking. Technical proficiency.</p>
      <p class="home-body">I develop ideas and build what they need to work: campaigns, content and the systems behind them.</p>
      <p class="home-body">Eight years across brands including AGL, Telstra, Coca-Cola and 7-Eleven.</p>
      <p class="home-body"><a href="/studio">See the client work</a></p>
    </div>
    {margins('hero').map((group) => <MarginCutouts group={group} />)}
  </section>

  <SkyPanel />

  <section class="home-section home-proof">
    <div class="home-col">
      <p class="home-body">You don't know the answer yet. You still have to make a start. I've worked across campaigns, content design and production, learning what the brief needs, making a version and changing how I work.</p>
      <p class="home-pointer"><a href="/studio/fearless-answers">Searching fearlessly for answers.</a></p>

      <nav class="home-destinations" aria-label="Where to go next">
        {destinations.map((destination) => (
          <a class="home-destination" href={destination.href}>
            <span class="home-destination-label">{destination.label}</span>
            <span class="home-destination-body">{destination.body}</span>
          </a>
        ))}
      </nav>

      <p class="home-body">Copywriter, painter, occasional collagist of whatever's left in the gutter. Freedom needs a frame, expression needs strategy, so he picked both and called it a practice (<a href="/personal">mostly to justify the paint</a>).</p>
      <p class="home-signature">Finn</p>
    </div>
    {margins('proof').map((group) => <MarginCutouts group={group} />)}
  </section>

  <FooterWordmark slot="after-footer" />
</BaseLayout>

<script>
  // Everything that moves on this page moves only while it is on screen and
  // the tab is visible. One observer drives the margin rotations and the
  // footer marks; reduced motion turns both off in CSS, so there is nothing to
  // start.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const stages = document.querySelectorAll<HTMLElement>('[data-margin-group], [data-footer-marks]');
    const onScreen = new Set<HTMLElement>();

    const sync = () => {
      for (const stage of stages) {
        stage.toggleAttribute('data-playing', onScreen.has(stage) && !document.hidden);
      }
    };

    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        const stage = entry.target as HTMLElement;
        if (entry.isIntersecting) onScreen.add(stage);
        else onScreen.delete(stage);
      }
      sync();
    }, { rootMargin: '80px 0px' });

    stages.forEach((stage) => observer.observe(stage));
    document.addEventListener('visibilitychange', sync);
  }
</script>
