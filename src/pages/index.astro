---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image, getImage } from 'astro:assets';
import wordmark from '../assets/brand/wordmark.png';
import wordmarkDark from '../assets/brand/wordmark-dark.png';
import sunFlourish from '../assets/brand/sun-flourish.png';
import sunset from '../assets/brand/stamps/sunset.png';
import sunStamp from '../assets/elements/print-monogram-square-framed.png';
import portrait from '../assets/brand/finn-portrait.png';

// Decorative stamps render at 64–112px; ship 2x webps rather than the
// full-size source PNGs (the sunset alone was ~800KB).
const [sunsetImg, flourishImg, sunStampImg] = await Promise.all([
  getImage({ src: sunset, width: 224, format: 'webp' }),
  getImage({ src: sunFlourish, width: 152, format: 'webp' }),
  getImage({ src: sunStamp, width: 128, format: 'webp' }),
]);

// Studio leads: it was missing entirely, and "Work" sent anyone looking for
// client work to the paintings. Art keeps the /work URL, loses the ambiguity.
// Lab sits second, between the register that pays and the one that doesn't:
// it is what makes the other two legible to a commercial reader.
const explore = [
  { href: '/studio', label: 'Studio', body: 'Campaigns, copy and content design. The briefs, the work and what I did.' },
  { href: '/tools', label: 'Lab', body: 'Small machines I built. What the new tools did well, and where they fell over.' },
  { href: '/work', label: 'Art', body: 'Collage, painting and mixed media, by chapter.' },
  { href: '/writing', label: 'Writing', body: 'Essays, oldest mistakes included.' },
];
---
<BaseLayout title="Finn Astle" register="art">
  <section class="hero">
    <img class="stamp" src={sunsetImg.src} alt="" aria-hidden="true"
      style="top:-0.5rem; right:-0.5rem; width:112px; transform:rotate(7deg);" />

    <p class="label" style="color: var(--graphite); margin-bottom: 0.5rem;">Finn Astle · Astle Creative</p>
    <h1 class="duality">Fearless <span class="amp">&amp;</span> Answers</h1>
    <p class="hero-sub">Proving the value of a creative thinker.</p>
    <p>I develop ideas and build what they need to work: campaigns, content and the systems behind them.</p>
    <p>Eight years across brands including AGL, Telstra, Coca-Cola and 7-Eleven.</p>
    <p><a href="/studio">See the client work</a></p>
  </section>

  <img class="flourish" src={flourishImg.src} alt="" aria-hidden="true" />

  <div class="wordmark-card">
    <img class="stamp stamp--ink" src={sunStampImg.src} alt="" aria-hidden="true"
      style="top:-1.6rem; right:1rem; width:64px; transform:rotate(6deg);" />
    <Image class="wordmark-light" src={wordmark} alt="Finn Astle, hand-brushed collage wordmark"
      widths={[700, 1400]} sizes="(max-width: 62rem) 100vw, 62rem" loading="eager" />
    <Image class="wordmark-dark" src={wordmarkDark} alt="" aria-hidden="true"
      widths={[700, 1400]} sizes="(max-width: 62rem) 100vw, 62rem" />
  </div>

  <p>You don't know the answer yet. You still have to make a start. I've worked across campaigns, content design and production, learning what the brief needs, making a version and changing how I work.</p>
  <p><a href="/studio/fearless-answers">Searching fearlessly for answers.</a></p>

  <nav class="explore" aria-label="Explore the site">
    {explore.map((e) => (
      <a class="explore-card" href={e.href}>
        <span class="explore-label">{e.label}</span>
        <span class="explore-body">{e.body}</span>
      </a>
    ))}
  </nav>

  <p>Copywriter, painter, occasional collagist of whatever's left in the gutter. Freedom needs a frame, expression needs strategy, so he picked both and called it a practice (<a href="/personal">mostly to justify the paint</a>).</p>

  <div class="sign-off">
    <Image class="portrait" src={portrait} alt="Finn Astle" width={96} height={96} />
    <p>Finn</p>
  </div>
</BaseLayout>

<style>
  .explore {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
    margin: 2.5rem 0;
  }
  .explore-card {
    display: block;
    position: relative;
    border: 1px solid var(--line);
    padding: 1.1rem 1.2rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .explore-card:hover { border-color: var(--accent); }
  .explore-label {
    display: block;
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.4rem;
    margin-bottom: 0.35rem;
  }
  .explore-card:hover .explore-label { color: var(--accent); }
  .explore-body {
    display: block;
    font-family: var(--sans);
    font-size: 0.8rem;
    color: var(--graphite);
  }
  /* Subtle desktop hover affordance: an arrow that slides in, and a small lift. */
  .explore-card::after {
    content: "→";
    position: absolute;
    top: 1.1rem;
    right: 1.2rem;
    font-family: var(--sans);
    color: var(--accent);
    opacity: 0;
    transform: translateX(-0.35rem);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  @media (hover: hover) {
    .explore-card:hover { transform: translateY(-2px); }
    .explore-card:hover::after { opacity: 1; transform: translateX(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .explore-card:hover { transform: none; }
  }

  .sign-off {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-top: -0.5rem;
  }
  .sign-off .portrait {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--line);
  }
  .sign-off p { margin: 0; }
</style>
