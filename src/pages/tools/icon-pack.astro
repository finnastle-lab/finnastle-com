---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';

// Finn Astle icon pack. Source of truth is Drive.
const files = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/elements/*.png',
  { eager: true },
);
const els = Object.entries(files)
  .map(([path, mod]) => {
    const base = path.split('/').pop()!.replace(/\.png$/, '');
    const label = base.replace(/^[0-9a-f]{6,}-/, '').replace(/-/g, ' ');
    return { src: mod.default, label };
  })
  .sort((a, b) => a.label.localeCompare(b.label));
---
<BaseLayout title="Icon Pack" description="Finn Astle icon pack: processed collage elements." register="art">
  <h1>Icon Pack</h1>
  <p><a href="/tools">← Tools</a> · Page two of the brand reference. The scanned
    collage elements, {els.length} of them.</p>

  <input
    type="text"
    class="icon-filter"
    placeholder="Filter by keyword — sun, mark, sketch…"
    aria-label="Filter icons by keyword"
    autocomplete="off"
  />
  <p class="icon-filter-count" role="status" aria-live="polite">{els.length} of {els.length}</p>

  <div class="icon-grid">
    {els.map((e) => (
      <figure class="icon-tile" data-label={e.label}>
        <div class="icon-frame">
          <Image src={e.src} alt={e.label} widths={[160, 320]} sizes="150px" />
        </div>
        <figcaption>{e.label}</figcaption>
      </figure>
    ))}
  </div>
  <p class="icon-filter-empty" hidden>Nothing matches that.</p>
</BaseLayout>

<script>
  const input = document.querySelector<HTMLInputElement>('.icon-filter');
  const tiles = document.querySelectorAll<HTMLElement>('.icon-tile');
  const count = document.querySelector<HTMLElement>('.icon-filter-count');
  const empty = document.querySelector<HTMLElement>('.icon-filter-empty');
  const total = tiles.length;

  const apply = () => {
    const q = (input?.value ?? '').trim().toLowerCase();
    let shown = 0;
    tiles.forEach((tile) => {
      const match = !q || (tile.dataset.label ?? '').toLowerCase().includes(q);
      tile.hidden = !match;
      if (match) shown++;
    });
    if (count) count.textContent = `${shown} of ${total}`;
    if (empty) empty.hidden = shown !== 0;
  };

  input?.addEventListener('input', apply);
</script>
