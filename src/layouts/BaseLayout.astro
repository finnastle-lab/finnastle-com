---
import Nav from '../components/Nav.astro';
import { getImage } from 'astro:assets';
import { SITE } from '../consts';
import sun from '../assets/elements/made-by-a-human-fa-sun-signature-stamp.png';
import defaultShare from '../assets/brand/wordmark.png';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  register?: 'art' | 'studio';
  // Keep a page out of the index (error pages, anything not meant to be found).
  noindex?: boolean;
  // Social share image (Open Graph / Twitter). Falls back to the wordmark.
  image?: ImageMetadata;
  imageAlt?: string;
  // 'article' for essays; everything else is a plain website page.
  ogType?: 'website' | 'article';
  publishedTime?: Date;
}

const {
  title, description = SITE.description, register = 'art', noindex = false,
  image, imageAlt, ogType = 'website', publishedTime,
} = Astro.props;
const fullTitle = title === SITE.title ? title : `${title} · ${SITE.title}`;
// build.format 'file' makes Astro.url.pathname '/exhibitions.html' at build
// time, but that URL 308s to the clean '/exhibitions' people actually visit —
// and a canonical must name the final, non-redirecting URL. Strip the suffix
// so the canonical matches the served URL. No-op in dev, where it's absent.
const canonicalPath = Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '');
const canonical = new URL(canonicalPath, Astro.site);
const year = new Date().getFullYear();

// The sun mark renders at 18–26px but the source PNG is ~90KB; ship a small
// webp at 2x instead. Nav.astro does the same for the masthead copy.
const sunMark = await getImage({ src: sun, width: 52, format: 'webp' });

// Share cards need an absolute URL. 1200px wide is the size the platforms ask for.
const share = await getImage({ src: image ?? defaultShare, width: 1200, format: 'jpg' });
const shareUrl = new URL(share.src, Astro.site);
const shareAlt = image ? (imageAlt ?? '') : 'Finn Astle, hand-brushed collage wordmark';
---
<!doctype html>
<html lang={SITE.locale} data-register={register}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {/* A noindex page gets no canonical: pairing the two sends mixed signals,
        and on an error page the canonical would point at whatever URL happened
        to 404 (or at /404.html), which is never a page worth pointing to. */}
    {noindex
      ? <meta name="robots" content="noindex, follow" />
      : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={SITE.locale.replace('-', '_')} />
    <meta property="og:image" content={shareUrl} />
    <meta property="og:image:width" content={String(share.attributes.width)} />
    <meta property="og:image:height" content={String(share.attributes.height)} />
    {shareAlt && <meta property="og:image:alt" content={shareAlt} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} · Writing`} href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cousine:ital,wght@0,400;0,700;1,400&family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&display=swap"
    />

    <!-- No-flash theme: apply stored choice before first paint. -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('fa-theme');
          if (t) document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <div class="frame">
      <a class="skip" href="#main">Skip to content</a>
      <Nav />
      <main id="main">
        <slot />
      </main>
      <footer>
        <img class="mark" src={sunMark.src} alt="" width="18" aria-hidden="true" />
        <span>F.A. · {year} · finnastle.com</span>
      </footer>
    </div>

    <script>
      const root = document.documentElement;
      const btn = document.querySelector('[data-theme-toggle]');
      const prefersDark = () => matchMedia('(prefers-color-scheme: dark)').matches;
      const current = () => root.getAttribute('data-theme') || (prefersDark() ? 'dark' : 'light');
      const sync = () => { if (btn) btn.textContent = current() === 'dark' ? 'Light' : 'Dark'; };
      sync();
      btn?.addEventListener('click', () => {
        const next = current() === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try { localStorage.setItem('fa-theme', next); } catch (e) {}
        sync();
      });
    </script>
  </body>
</html>
