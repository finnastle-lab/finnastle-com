---
import { NAV } from '../consts';
import sun from '../assets/brand/sun.png';
const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  path === href || (href !== '/' && path.startsWith(href));
---
<header class="masthead">
  <div class="masthead-in">
    <a class="brand" href="/">
      <img class="mark" src={sun.src} alt="" width="26" aria-hidden="true" />
      <span class="name">Finn Astle</span>
    </a>
    <nav aria-label="Primary">
      <ul>
        {NAV.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <button class="invert-btn" type="button" aria-label="Toggle colour theme" data-theme-toggle>Dark</button>
  </div>
</header>
